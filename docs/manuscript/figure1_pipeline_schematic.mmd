%% Figure 1 — Metagenomics Pipeline Automation: workflow schematic
%% Render to SVG/PNG with: mmdc -i figure1_pipeline_schematic.mmd -o figure1.svg
flowchart TD
    classDef input fill:#eef6ff,stroke:#4a78b8,color:#1b3a66
    classDef cfg   fill:#fff7e6,stroke:#c08a00,color:#5a3d00
    classDef stage fill:#f5f5f5,stroke:#666,color:#222
    classDef comm  fill:#e8f5e9,stroke:#3c8a47,color:#1f4a26
    classDef func  fill:#fdecea,stroke:#b54343,color:#5a1f1f
    classDef net   fill:#ede7f6,stroke:#5e35b1,color:#2c1a5e
    classDef out   fill:#fffde7,stroke:#9c8d1c,color:#3f3a0a

    subgraph INP["Upstream outputs (run prior to pipeline)"]
        K["Kraken2 / Bracken<br/>tables"]:::input
        A["ABRicate calls<br/>CARD &middot; VFDB &middot; PlasmidFinder"]:::input
        R["Re-centrifuge<br/>contamination tags"]:::input
        M["Sample metadata"]:::input
    end

    CFG["config.yaml<br/>(one per study)"]:::cfg

    subgraph PIPE["R workflow &mdash; R/00 to R/14"]
        S0["R/00 setup<br/>library load &middot; config validation"]:::stage
        S1["R/01 load inputs"]:::stage
        S2["R/02 clean<br/>taxid_fixes &middot; decontaminate &middot; Bracken merge &middot; link ABRicate to taxa"]:::stage
        S3["R/03 TPM normalisation<br/>per (sample, GENE) over ABRicate hits"]:::stage

        subgraph COMM["Community analyses"]
            S4["R/04 taxonomy<br/>Venn &middot; heatmaps"]:::comm
            S5["R/05 relative abundance<br/>stacked bar &middot; plotly &middot; prevalence"]:::comm
            S6["R/06 alpha diversity<br/>precomputed CSV or vegan &middot; KW &middot; violin/bar"]:::comm
            S7["R/07 beta diversity<br/>Hellinger-Bray-Curtis PCoA &middot; PERMANOVA &middot; PERMDISP"]:::comm
            S8["R/08 differential abundance<br/>ALDEx2 two-level (taxa + gene) &middot; KW + pairwise"]:::comm
        end

        subgraph FUNC["Functional profiling<br/>(alpha &middot; Venn &middot; heatmap &middot; PCoA &middot; prevalence)"]
            S9["R/09 resistome<br/>CARD &middot; drug-class + MLS"]:::func
            S10["R/10 virulome<br/>VFDB &middot; function category"]:::func
            S11["R/11 mobilome<br/>PlasmidFinder &middot; replicon family"]:::func
        end

        S12["R/12 network<br/>tripartite (sample &times; taxon &times; gene) &middot; chord &middot; Sankey &middot; Gephi &middot; igraph topology"]:::net
        S14["R/14 publication panels<br/>main + supplementary composites (PNG / TIFF) &middot; supplementary_tables.xlsx"]:::stage
        S13["R/13 manifest<br/>manifest.json (contract v1.2)<br/>kind-tagged figure &amp; table catalogue"]:::stage
    end

    QR["Quarto HTML dashboard<br/>(per-domain panels)"]:::out
    PUB["Publication-ready figures<br/>+ supplementary tables workbook"]:::out

    CFG --> S0
    K --> S1
    A --> S1
    R --> S1
    M --> S1
    S0 --> S1
    S1 --> S2
    S2 --> S3
    S3 --> COMM
    S3 --> FUNC
    COMM --> S12
    FUNC --> S12
    COMM --> QR
    FUNC --> QR
    S12 --> QR
    S12 --> S14
    S14 --> PUB
    S14 --> S13
    QR --> S13
